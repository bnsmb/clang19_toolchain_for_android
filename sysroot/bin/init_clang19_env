#    added the function "add_option" to add the options to the environment variables with compiler/linker flags
#
#  10.06.2026 v1.5.14 /bs
#    added the parameter "norootcheck" to disable the check for root access
#    added the environment variable CHECK_ROOT_ACCESS to disable the check for root access
#    fixed a bug in the code to get the value for the variable CLANG_SYSROOT
#    added the environment variable IGNORE_GCC_TOOLCHAIN to ignore the gcc toolchain
#    renamed the parameter "no_gcc_dir" with "ignoregcc"
#
#  15.06.2026 v1.5.15 /bs
#    the script now prints a summary of all warnings at script end
#    the script now prints also the contents of the variable GCC if gcc was found and not disabled
#
#  12.07.2026 v1.5.16 /bs
#    added the alias update_config_guess to update config.guess and config.sub in the current directory
#    added the alias ll=exa
#
#
#
__TRUE=0
__FALSE=1

STANDALONE_SCRIPT=${__FALSE}

CONTINUE=${__TRUE}

# list of warning messages to print a script end
#
WARNING_MESSAGES=""

if [ ${CONTINUE} = ${__TRUE} ] ; then

# this variable is set to true if the parameter "examples" is used
#
  PRINT_EXAMPLES=${__FALSE}

# alias to print debug messages if requested
#
  alias LogDebugMsg='[ "${DEBUG}"x != ""x ] && echo "DEBUG: $*" >&2 '

# get the current Android version
#
  OS_VERSION="$( getprop ro.build.version.release  )"

# this is NOT a supported environment variable -> use this syntax to avoid adding the variable to the list of supported environment variables in the usage output
#  
  if [ "${OS_VERSION}"x = ""x ] ; then
    OS_VERSION="99}"
  fi

# the test binary to use
#
  TEST="$( which test )"

# this is NOT a supported environment variable -> use this syntax to avoid adding the variable to the list of supported environment variables in the usage output
#
  [ "${TEST}"x = ""x ] && TEST="test"


# set this variable to ${__TRUE} to disable adding the directory with the gcc toolchain to the PATH
#
  IGNORE_GCC_TOOLCHAIN="${IGNORE_GCC_TOOLCHAIN:=${__FALSE}}"
  
# set this variable to ${__FALSE} to disable the CPU check
#
  CHECK_CPU="${CHECK_CPU:=${__TRUE}}"

# set this variable to ${__FALSE} to disable the check for root access
#
  CHECK_ROOT_ACCESS="${CHECK_ROOT_ACCESS:=${__TRUE}}"

# the name of this script
#
  THIS_SCRIPT="$0"

# check if this script was sourced in
#
  if [[ "${THIS_SCRIPT}" != */init_clang*_env ]] ; then
    THIS_SCRIPT="/data/local/tmp/sysroot/bin/init_clang19_env"
  else
    CLANG_SYSROOT="$( cd "${THIS_SCRIPT%/bin/*}" && pwd )"
  fi

# ---------------------------------------------------------------------
# the variable TMPDIR is used by the /sytem/bin/sh to get the default directory for temporary files
#
  TMPDIR="${TMPDIR:=/data/local/tmp}"
  export TMPDIR

fi

# ---------------------------------------------------------------------
# add a directory to the variable PATH if it is not already included
#
# usage:  add_path dir_with_executables [...]
#
function add_path {

  typeset CUR_DIR=""
  
  while [ $# -ne 0 ] ; do
    CUR_DIR="$1"
    shift
    [[ *:${PATH}:* != *:${CUR_DIR}:* ]]  && PATH="${PATH}:${CUR_DIR}"
  done
}

# ---------------------------------------------------------------------
# add a directory to the variable LD_LIBRARY_PATH if it is not already included
#
# usage: add_library_path dir_with_libraries [...]
#
function add_library_path {

  typeset CUR_DIR=""

  while [ $# -ne 0 ] ; do
    CUR_DIR="$1"
    shift
    [[ *:${LD_LIBRARY_PATH}:* != *:${CUR_DIR}:* ]]  && LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${CUR_DIR}"
  done
}

# ---------------------------------------------------------------------
# add an option an environment variable if it is not already included
#
# usage: add_option env_variable option
#
function add_option {
  eval echo \" \$$1 \" | grep -- " $2 " >/dev/null || \
    eval $1=\"\$$1 $2 \"
}

# ---------------------------------------------------------------------

function define_aliase {

  NEW_ALIAS=""

  for i in vi find tar bash sed awk dd nano curl ; do
    if ${TEST} -x "${CLANG_SYSROOT}/usr/bin/$i"  ; then
       alias $i="${CLANG_SYSROOT}/usr/bin/$i"
      NEW_ALIAS="${NEW_ALIAS} $i"
    fi
  done

  for i in /system_ext/bin/* /product/bin/* ; do 
    f=${i##*/} 
    [[ " ${NEW_ALIAS} " == *\ $f\ * ]] && continue

    if [ -x "${CLANG_SYSROOT}/usr/bin/$f"  ] ; then
      alias $f="${CLANG_SYSROOT}/usr/bin/$f"
      NEW_ALIAS="${NEW_ALIAS} $f"
    elif [ -x "${CLANG_SYSROOT}/usr/sbin/$f" ] ; then
      alias $f="${CLANG_SYSROOT}/usr/sbin/$f"
      NEW_ALIAS="${NEW_ALIAS} $f"
    fi
  done

  for i in ${NEW_ALIAS} ; do
    alias $i
  done

}

function clear_aliase {

  for CUR_ALIAS in ${NEW_ALIAS} ; do
    unalias ${CUR_ALIAS}
  done
}

# ---------------------------------------------------------------------

function print_warning {
  typeset CUR_WARNING="$*"

  WARNING_MESSAGES="${WARNING_MESSAGES}
${CUR_WARNING}"    

   echo "${CUR_WARNING}"

}

# ---------------------------------------------------------------------
# main function starts here
#

USER_COMMAND=""

if [ ${CONTINUE} = ${__TRUE} ] ; then

  while [ $# -ne 0 ] ; do
    CUR_PARAMETER="$1"
    shift

    case ${CUR_PARAMETER} in
 
      -h | --help | help )

        if ${TEST} -r "${THIS_SCRIPT}"  ; then
          SUPPORTED_ENV_VARIABLES="Supported environment variables are:

$( grep ":=" ${THIS_SCRIPT} | grep -v SUPPORTED_ENV_VARIABLES  )
"
        else
          SUPPORTED_ENV_VARIABLES=""
        fi
        cat <<EOT

Usage: . ${THIS_SCRIPT} [-h|--help] [init] [var=value] [examples] [nocpucheck] [norootcheck] [ignoregcc] [run "command1; command2; ..."]

 
init        - clear the used environment variables at script start
var=value   - set the environment variable "var" to "value" at start of the script
examples    - print compile examples after initializing the environment
nocpucheck  - disable the CPU check
norootcheck - disable the check for root access
ignoregcc   - ignore the gcc 
run         - init the environment; run the commands and exit

${SUPPORTED_ENV_VARIABLES}

To use another toolchain base directory use this syntax:

  CLANG_SYSROOT=${CLANG_SYSROOT}  source \${CLANG_SYSROOT}/bin/init_clang19_env

To run only one or more commands use the parameter "run", e.g. to compile the examples use the command:

sh /data/local/tmp/sysroot/bin/init_clang19_env run "/data/local/tmp/sysroot/compile_examples.sh"

EOT

        CONTINUE=${__FALSE}
        break
        ;;

      ignoregcc | ignore_gcc )
        IGNORE_GCC_TOOLCHAIN=${__TRUE}
        ;;

      nocpucheck | no_cpucheck | no_cpu_check )
        CHECK_CPU=${__FALSE}
        ;;

      norootcheck | no_rootcheck | no_root_check )
        CHECK_ROOT_ACCESS=${__FALSE}
        ;;

      examples | example | ex )
        PRINT_EXAMPLES=${__TRUE}
        ;;

      init | clear )
        echo "Clearing all used variables ..."
        unset CFLAGS CPPFLAGS CXXFLAGS LDFLAGS API SYSROOT TARGET_ROOT CLANG_DIR CLANG_VERSION NDK_DIR
        ;;

      *=* )
        echo "Executing now \"${CUR_PARAMETER}\" ..."
        eval ${CUR_PARAMETER}
        if [ $? -ne 0 ] ; then
          echo "ERROR: Error executing \"${CUR_PARAMETER}\" "
          CONTINUE=${__FALSE}
        fi
        ;;

      run  )
        USER_COMMAND="$*"
        if [ "${USER_COMMAND}"x = ""x ] ; then
          echo "ERROR: No command for the parameter \"run\" found"
          CONTINUE=${__FALSE}
        else
          echo "Found command to execute in the parameter: \"${USER_COMMAND}\"  "
        fi
        break 
        ;;

      * )
        echo "ERROR: Unknown parameter found: \"${CUR_PARAMETER}\" "
        CONTINUE=${__FALSE}
        ;;
    esac
  done
fi

# ---------------------------------------------------------------------

if [ ${CONTINUE} = ${__TRUE} ] ; then

#
#  sysroot for the clang binaries and the other tools (make, etc)
#
  CLANG_SYSROOT="${CLANG_SYSROOT:=/data/local/tmp/sysroot}"
  export CLANG_SYSROOT

  echo "The toolchain directory used is \"${CLANG_SYSROOT}\" "

# certificate file
#
  DEFAULT_SSL_CERT_FILE="${CLANG_SYSROOT}/etc/security/ca-certificates.crt"

# optional additional sysroot for additional libaries and include files
# 
  TARGET_ROOT="${TARGET_ROOT:=/data/local/tmp/develop/sysroot}"

# directory with GCC binaries
#
  GCC_BIN_DIR="${CLANG_SYSROOT}/usr/gcc/bin/gcc-toolchain"

# clang version 
#
  CLANG_VERSION="${CLANG_VERSION:=19}"

# directory with the files for clang
# 
  CLANG_DIR="${CLANG_DIR:=${CLANG_SYSROOT}/usr/clang${CLANG_VERSION}}"

# NDK to use
#
  NDK="${NDK:=r27d}"

# directory with the files from the NDK
#
  NDK_DIR="${NDK_DIR:=${CLANG_SYSROOT}/usr/ndk/${NDK}}"


# sysroot directory from the NDK
#
  SYSROOT="${SYSROOT:=${NDK_DIR}/sysroot}"

# API version 
#
  API=${API:=31}
 
# magiskpolicy is optional used to change SELinux permissions 
#
  MAGISKPOLICY="$( which magiskpolicy 2>/dev/null )"

# SELinux helpler script for machines with root access but without Magisk
#
  SELINUX_HELP_SCRIPT="$( which add_missing_selinux_rules.sh )"


  MANPATH=${CLANG_SYSROOT}/usr/share/man

  HOME="${CLANG_SYSROOT}/home/shell"

  TERMINFO="${CLANG_SYSROOT}/usr/share/terminfo"

  add_path "${CLANG_SYSROOT}/usr/bin" "${CLANG_SYSROOT}/bin"

  add_library_path "${CLANG_SYSROOT}/usr/lib"

# ---------------------------------------------------------------------
#
# check if the gcc is part of this version of the clang19 toolchain
#
  GCC=""
  if [ ${IGNORE_GCC_TOOLCHAIN}x != ${__TRUE}x ] ; then
    if [ -d "${GCC_BIN_DIR}" ] ; then
      add_path "${GCC_BIN_DIR}"

      [ -x "${GCC_BIN_DIR}/gcc" ] && GCC="${GCC_BIN_DIR}/gcc" 
    else
      echo "No GCC toolchain found"
    fi
  else
    echo "Adding the GCC toolchain to the path is disabled"
  fi
fi

# ---------------------------------------------------------------------

  export HOME TERMINFO PATH LD_LIBRARY_PATH MAN_PATH

# ---------------------------------------------------------------------

if [ ${CONTINUE} = ${__TRUE} ] ; then

  ROOT_ACCESS_AVAILABLE=${__FALSE}
  ROOT_PREFIX=""

  if [ ${CHECK_ROOT_ACCESS} = ${__TRUE} ] ; then 
    CUR_USER="$( id -un )"

    if [ "${CUR_USER}"x = "root"x ] ; then
      ROOT_ACCESS_AVAILABLE=${__TRUE}
    else 
      su - -c id 2>/dev/null 1>/dev/null 
      if [ $? -eq 0 ] ; then
        ROOT_ACCESS_AVAILABLE=${__TRUE}
        ROOT_PREFIX="su - -c "
      fi
    fi
  else
    echo "Checking for root access is disabled"
  fi
fi

# ---------------------------------------------------------------------

if [ ${CONTINUE} = ${__TRUE} ] ; then

#
# 06.06.2025 /bs : CPU_TYPE is hardcoded now; CUR_CPU_TYPE is only used for messages
#
  CPU_TYPE="aarch64"

  CUR_CPU_TYPE="$( uname -m )"

#
# check, if the current CPU can execute binaries compiled for arm64
#
  if [ ${CHECK_CPU}x != ${__FALSE}x ] ; then
    CHECK_CPU_TEST_PROGRAM="${CLANG_SYSROOT}/bin/testcpu"
    if [ -x "${CHECK_CPU_TEST_PROGRAM}" ] ; then
      echo "Checking if the current CPU can execute binaries for arm64 CPUs using the binary \"${CHECK_CPU_TEST_PROGRAM}\" ..."
      ${CHECK_CPU_TEST_PROGRAM}
      if [ $? -ne 0 ] ; then
        echo "ERROR: Looks like the current CPU can NOT execute binaries for arm64 CPUs"
        echo "       Note: To disable this test either use the parameter \"nocpucheck\" or delete or rename the file \"${CHECK_CPU_TEST_PROGRAM}\" "
        CONTINUE=${__FALSE}
      fi
    else
      echo "The CPU check program  \"${CHECK_CPU_TEST_PROGRAM}\" does not exist or is not executable - no CPU check done"
    fi
  fi
fi

# ---------------------------------------------------------------------

if [ ${CONTINUE} = ${__TRUE} ] ; then

  echo "Running as user \"${CUR_USER}\" "

  if [[ $0 == *init_clang*_env* ]] ; then
    if [[  "${USER_COMMAND}"x = ""x ]] ; then
      echo
      echo "*******************************************************************************************"
      print_warning "WARNING: The script $0 must be sourced in "
      echo "*******************************************************************************************"
      echo
    fi
    STANDALONE_SCRIPT=${__TRUE} 
  fi

# ---------------------------------------------------------------------

  LIB_DIRS="${CLANG_SYSROOT}/usr/lib"

  OBJ_DIRS=""

  INCLUDE_DIRS="${CLANG_SYSROOT}/usr/include ${CLANG_DIR}/include"

  BIN_DIRS="${CLANG_DIR}/bin"

  SYSROOT_CONFIGURE_OPTION=""
 
  if [ "${NDK_DIR}"x != ""x ] ; then
    if ${TEST} -d "${NDK_DIR}" ; then
       INCLUDE_DIRS="${INCLUDE_DIRS} ${NDK_DIR}/include ${NDK_DIR}/sysroot/usr/include/${CPU_TYPE}-linux-android"
    fi
  fi

  if [ "${SYSROOT}"x != ""x ] ; then
    if ${TEST} -d  "${SYSROOT}" ; then

      SYSROOT_LIB_DIR="${SYSROOT}/usr/lib/${CPU_TYPE}-linux-android"

      INCLUDE_DIRS="${INCLUDE_DIRS} ${SYSROOT}/usr/include"

      LIB_DIRS="${LIB_DIRS} ${SYSROOT_LIB_DIR}/${API}"
      OBJ_DIRS="${OBJ_DIRS} ${SYSROOT_LIB_DIR}/${API}"

      LIB_DIRS="${LIB_DIRS} ${SYSROOT_LIB_DIR}"

      ${TEST} -d ${SYSROOT}/usr/bin && BIN_DIRS="${BIN_DIRS} ${SYSROOT}/usr/bin"

      SYSROOT_CONFIGURE_OPTION="--sysroot ${SYSROOT}"

    else
      print_warning "WARNING: The sysroot directory ${SYSROOT} does not exist"
    fi
  fi

  CLANG="${CLANG_DIR}/bin/clang"

  add_path "${CLANG_DIR}/bin"

# ---------------------------------------------------------------------

  if ${TEST} ! -x "${CLANG}"  ; then
    echo "ERROR: The binary ${CLANG} does not exist or is not executable"
    CONTINUE=${__FALSE}
  fi
fi

# ---------------------------------------------------------------------

if [ ${CONTINUE} = ${__TRUE} ] ; then

  echo
  echo "Preparing the clang environment for creating binaries for the CPU type ${CPU_TYPE}"

  if [ "${CUR_CPU_TYPE}"x != "${CPU_TYPE}"x ] ; then
    echo "The current CPU type is \"${CUR_CPU_TYPE}\" "
  fi

  if [ "${TARGET_ROOT}"x != ""x ] ; then
    if ${TEST} -d  "${TARGET_ROOT}"  ; then
      INCLUDE_DIRS="${INCLUDE_DIRS} ${TARGET_ROOT}/usr/include"
      BIN_DIRS="${BIN_DIRS} ${TARGET_ROOT}/usr/bin"
      LIB_DIRS="${LIB_DIRS} ${TARGET_ROOT}/usr/lib"
    else
     echo "INFO: The target root directory ${TARGET_ROOT} does not exist"
    fi
  fi

  echo ""

  printf "%-90s %s\n" "Using clang ${CLANG_VERSION}" 
  printf "\n"

  if [ "${NDK_DIR}"x != ""x ] ; then
    printf "%-90s %s\n" "Using the NDK ${NDK_DIR}" "(environment variable NDK_DIR)"
  fi

  if [ "${SYSROOT}"x != ""x ] ; then
    printf "%-90s %s\n" "Using the sysroot directory ${SYSROOT}" "(environment variable SYSROOT)"
  fi

  if [ "${TARGET_ROOT}"x != ""x ] ; then
    printf "%-90s %s\n" "Using the target root directory ${TARGET_ROOT}" "(environment variable TARGET_ROOT)"
  fi

  printf "\n"

  echo ""

  for CUR_DIR in ${BIN_DIRS} ; do
    echo ":${PATH}:" | grep ":${CUR_DIR}:" >/dev/null
    if [ $? -ne 0 ] ; then
      if ! ${TEST} -d "${CUR_DIR}" ; then
        print_warning "WARNING: The directory with binaries \"${CUR_DIR}\" does not exist"
      fi
      [[ :${PATH}: != *:${CUR_DIR}: ]] && PATH="${CUR_DIR}:${PATH}"
    fi
  done
 
 
  for CUR_DIR in ${INCLUDE_DIRS} ; do
    if ! ${TEST} -d "${CUR_DIR}" ; then
      print_warning "WARNING: The directory with include files \"${CUR_DIR}\" does not exist"
    fi

    add_option   CFLAGS "-I${CUR_DIR} "
    add_option CPPFLAGS "-I${CUR_DIR} "
    add_option CXXFLAGS "-I${CUR_DIR} "

  done

  for CUR_DIR in ${LIB_DIRS} ; do
    if ! ${TEST} -d "${CUR_DIR}" ; then
      print_warning "WARNING: The directory with libraries \"${CUR_DIR}\" does not exist"
    fi

    add_option LDFLAGS "-L${CUR_DIR} "

  done


  for CUR_DIR in ${OBJ_DIRS} ; do
    if ! ${TEST} -d "${CUR_DIR}" ; then
      print_warning "WARNING: The directory with object files \"${CUR_DIR}\" does not exist"
    fi

    add_option LDFLAGS "-B${CUR_DIR}/ "

  done


  if [ "${SYSROOT_CONFIGURE_OPTION}"x != ""x ] ; then 

    add_option   CFLAGS "--sysroot=${SYSROOT}"
    add_option CPPFLAGS "--sysroot=${SYSROOT}"
    add_option CXXFLAGS "--sysroot=${SYSROOT}"
    add_option  LDFLAGS "--sysroot=${SYSROOT}"

  fi

  add_option  LDFLAGS "-lc"


  add_library_path "${SYSROOT}/usr/lib/${CPU_TYPE}-linux-android" "${CLANG_DIR}/lib"

  for CUR_PKG_CONFIG_PATH  in /data/local/tmp/sysroot/usr/lib/pkgconfig/ /data/local/tmp/develop/sysroot/usr/lib/pkgconfig/ ; do
    if [[ " :${PKG_CONFIG_PATH}: " != *:${CUR_PKG_CONFIG_PATH}:* ]] ; then
      export PKG_CONFIG_PATH="${PKG_CONFIG_PATH}:${CUR_PKG_CONFIG_PATH}"
    fi 
  done


  export CFLAGS CXXFLAGS CPPFLAGS LDFLAGS SYSROOT TARGET_ROOT API NDK SYSROOT PKG_CONFIG_PATH

  export CC="${CLANG_DIR}/bin/clang"
  export CXX="${CLANG_DIR}/bin/clang++"
  export AR="${CLANG_DIR}/bin/llvm-ar"
  export AS="${CLANG_DIR}/bin/llvm-as"
  export LD="${CLANG_DIR}/bin/lld"
  export RANLIB="${CLANG_DIR}/bin/llvm-ranlib"
  export STRIP="${CLANG_DIR}/bin/llvm-strip"
  export CPP="${CLANG_DIR}/bin/clang-cpp"
  export CXXCPP="${CLANG_DIR}/bin/clang-cpp"

  if [ "${PKG_CONFIG}"x = ""x ] ; then
    export PKG_CONFIG="${CLANG_DIR}/bin/pkg-config"
  fi

  echo "Environment variables used:"

  CUR_VAR_NAME_FIELD_LENGTH=25

  printf "\n"
  printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "PATH is now:"             "${PATH}"
  printf "\n"

  printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "LD_LIBRARY_PATH:"         "${LD_LIBRARY_PATH}"
  printf "\n"
  printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "API is now:"              "${API}"
  printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "NDK_DIR is now:"          "${NDK_DIR}"
  printf "\n"
  printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "SYSROOT is now:"          "${SYSROOT}"
  printf "\n"

  printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "CFLAGS are now:"          "${CFLAGS}"
  printf "\n"
  printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "CPPFLAGS are now:"        "${CPPFLAGS}"
  printf "\n"
  printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "CXXFLAGS are now:"        "${CXXFLAGS}"
  printf "\n"
  printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "LDFLAGS are now:"         "${LDFLAGS}"
  printf "\n"

  for CUR_VAR in CC CXX CPP CXXCPP AR AS LD RANLIB STRIP GCC PKG_CONFIG PKG_CONFIG_PATH  ; do
    eval CUR_VALUE="\$$CUR_VAR"
    [ "${CUR_VALUE}"x = ""x ] && continue
    
    printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "${CUR_VAR} is now:" "${CUR_VALUE}"
  done
 
  echo

  if  ! ${TEST} -d /tmp  ; then
    if [ "${TMP}"x = ""x ] ; then
      if ${TEST} -d /data/local/tmp  ; then
        export TMP="/data/local/tmp"
        printf "%-${CUR_VAR_NAME_FIELD_LENGTH}s %s\n" "TMP is now:"         "${TMP}"
      else
        print_warning "WARNING: The directories /tmp and /data/local/tmp do not exist - please set the variable TMP before using clang"
      fi
    fi
  fi 

  echo "Checking the clang binary ..."
  echo
  ${CLANG} --version
  THISRC=$?
  echo
  if [ ${THISRC} != 0 ] ; then
    print_warning "WARNING: Executing \"${CLANG} --version\" ended with RC=${THISRC}"
  fi

  if [ $API -lt 30 ] ; then
    print_warning "WARNING: The current API version is ${API} -- compiling C++ program using API version less then 30 with clang or clang++ will probably not work"
  fi

  if [ "${GCC}"x != ""x ] ; then
    echo "Checking the gcc binary ..."
    echo
    ${GCC} --version
    THISRC=$?
    echo
    if [ ${THISRC} != 0 ] ; then
      print_warning "WARNING: Executing \"${GCC} --version\" ended with RC=${THISRC}"
    fi
  else
    if [ ${IGNORE_GCC_TOOLCHAIN} = ${__FALSE} ] ; then
      echo "INFO: The gcc does not exist in this environment"
    fi
  fi

  export CC=${CLANG}
  export LD=${LLD}

# define aliase
#
  echo "Define some aliase ..."

  NEW_ALIAS=""

  alias sysroot="cd ${CLANG_SYSROOT}; pwd"

  alias setlibpath="export LD_LIBRARY_PATH=${LD_LIBRARY_PATH}"
 
  alias addlib='LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/data/local/tmp/develop/sysroot/usr/lib '

  alias cp_crt_libs='cp ${NDK_DIR}/sysroot/usr/lib/${CPU_TYPE}-linux-android/${API}/crt*.o .'

  alias update_config_guess='wget https://raw.githubusercontent.com/gcc-mirror/gcc/master/config.guess -O config.guess ; wget https://raw.githubusercontent.com/gcc-mirror/gcc/master/config.sub -O config.sub'

  alias gdb="gdb -tui "

  [ -x ${CLANG_SYSROOT}/usr/bin/eza ] && alias ll="${CLANG_SYSROOT}/usr/bin/eza"

  define_aliase

  echo ""

  if [ ${ROOT_ACCESS_AVAILABLE} = ${__TRUE} ] ; then

    if [ "${ROOT_PREFIX}"x = ""x ] ; then
      echo "The user running this script is the user \"root\" "
    else
      echo "Root access is enabled on this machine"
      echo ""

      if [ "${MAGISKPOLICY}"x != ""x ] ; then

        echo "Adding missing SELinux policies using \"${MAGISKPOLICY}\" ..."

        echo "Enabling socket access for the user \"shell\" (this is necessary to use tmux or ssh-agent)..."

        ${ROOT_PREFIX} ${MAGISKPOLICY} '--live "allow shell shell_data_file sock_file { create getattr setattr write unlink }"  '
        ${ROOT_PREFIX} ${MAGISKPOLICY} '--live "allow shell devpts chr_file { read write open }"'

        if which mtr 2>/dev/null 1>dev/null ; then
          echo "Enabling icmp_socket access for the user \"shell\" (this is necessary to use mtr)..."
          ${ROOT_PREFIX} ${MAGISKPOLICY} '--live "allow shell port icmp_socket { name_bind }"'     
        fi

        echo "Enabling hard links for the user \"shell\" ..."
        ${ROOT_PREFIX} ${MAGISKPOLICY} '--live "allow shell shell_data_file file link" '
 

        if [ ${OS_VERSION} -gt 13 ] ; then
          echo "Enabling creating and using fifos for the user \"shell\" ..."
          ${ROOT_PREFIX} ${MAGISKPOLICY} '--live "allow shell shell_data_file fifo_file { create read open write getattr unlink ioctl }" '
        fi

      elif [ "${SELINUX_HELP_SCRIPT}"x != ""x ] ; then

        echo "Adding missing SELinux policies using the script \"${SELINUX_HELP_SCRIPT}\" ..."

        ${ROOT_PREFIX} ${SELINUX_HELP_SCRIPT}

      else
        LogDebugMsg "Magisk is not installed on this machine and the SELinux helper script is missing - can not add missing SELinux rules"
      fi
    fi

    echo ""
  else
    LogDebugMsg  "root access is NOT enabled on this machine"
  fi

  if ${TEST} -r  ${DEFAULT_SSL_CERT_FILE}  ; then
    echo "Setting the variable \"SSL_CERT_FILE\" to \"${DEFAULT_SSL_CERT_FILE}\" ..."
    export SSL_CERT_FILE=${DEFAULT_SSL_CERT_FILE}
  else
    print_warning "WARNING: Certificate file \"${DEFAULT_SSL_CERT_FILE}\" not found "
  fi

  echo "$PS1" | grep "\[clang19" 2>/dev/null >/dev/null || export PS1="[clang19 toolchain] $PS1" 

  CLANG_ENV_INIT_DONE=${__TRUE}

  echo ""

  if [ "${HOSTNAME}"x = ""x ] ; then
    if [ $( hostname )x != "localhost"x ] ; then
      export HOSTNAME="$( hostname )"
    else
      export HOSTNAME="$( getprop ro.product.device ) $( getprop ro.serialno )"
    fi
  fi
fi

if [ ${PRINT_EXAMPLES} = ${__TRUE} ] ; then

  cat <<EOT

# ---------------------------------------------------------------------
#
# To test the C compiler "clang" use

cd ${CLANG_SYSROOT}
clang \${CFLAGS} \${LDFLAGS} -o helloworld_in_c helloworld_in_c.c  && ./helloworld_in_c

# ---------------------------------------------------------------------
#
# To test the C++ compiler "clang++" use

cd ${CLANG_SYSROOT}
clang++ \${CPPFLAGS} \${LDFLAGS}  -o helloworld_in_c++ ./helloworld_in_c++.cpp && ./helloworld_in_c++

# ---------------------------------------------------------------------
#
# To test the assembler from "clang" use

cd ${CLANG_SYSROOT}
clang -nostdlib -static -Wl,--entry=_start -o helloworld_in_assembler helloworld_in_assembler.s && ./helloworld_in_assembler

# ---------------------------------------------------------------------
#
# To test the assembler from the binutils "as" use

cd ${CLANG_SYSROOT}
${CLANG_SYSROOT}/usr/bin/as -o helloworld_in_assembler_for_as.o helloworld_in_assembler_for_as.s && \
  ${CLANG_SYSROOT}//usr/bin/ld -o helloworld_in_assembler_for_as helloworld_in_assembler_for_as.o && \
  ./helloworld_in_assembler_for_as

EOT

  if [ "${GCC}"x != ""x ] ; then
  cat <<EOT

# ---------------------------------------------------------------------
#
# To test the C compiler "gcc" use

cd ${CLANG_SYSROOT}
gcc -o helloworld_in_c helloworld_in_c.c  && ./helloworld_in_c

# ---------------------------------------------------------------------
#
# To test the C++ compiler "g++" use

cd ${CLANG_SYSROOT}
g++  -o helloworld_in_c++ ./helloworld_in_c++.cpp && ./helloworld_in_c++

EOT
  fi

fi

if [ "${USER_COMMAND}"x != ""x ] ; then
  echo ""
  echo " ---------------------------------------------------------------------------- "
  echo "clang19 environment initialized"
  echo ""
  echo "Executing now \"${USER_COMMAND}\" ..."
  echo ""
  eval ${USER_COMMAND}
  THISRC=$?
  echo ""
  echo "... done; RC=${THISRC}"
  [ ${STANDALONE_SCRIPT} = ${__TRUE} ] && exit ${THISRC}
fi

if [ ${CONTINUE} = ${__TRUE} ] ; then

# change the working directory /data/local/tmp if it's currently /
#
  if [ "$PWD"x = "/"x -a ${CONTINUE} != ${__FALSE} -a ${STANDALONE_SCRIPT} != ${__TRUE} -a "${USER_COMMAND}"x = ""x ] ; then
    echo 

    WORKDIR="${CLANG_SYSROOT}"

    if [ "${TARGET_ROOT}"x != ""x ] ; then
      if ${TEST} -d  "${TARGET_ROOT%/sysroot*}"  ; then
        WORKDIR="${TARGET_ROOT%/sysroot*}"
      fi
    fi

    echo "Changing the working directory to \"${WORKDIR}\" ..."
    cd "${WORKDIR}" 
  fi
fi

if [ ${CONTINUE} = ${__TRUE} ] ; then

  if [ "${WARNING_MESSAGES}"x != ""x ] ; then
    echo "
Issues found while initializing the environment:

${WARNING_MESSAGES}

"
  fi
fi
