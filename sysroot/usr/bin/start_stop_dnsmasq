#!/system/bin/sh
#
# start/stop script for dnsmasq
#
# History
#   04.06.2026 /bs
#     initial release
#

__TRUE=0
__FALSE=1

# The dnsmasq command needs root acces
#
ROOT_PREFIX=""

if [ "$( id -un )"x != "root"x ] ; then
  ${ROOT_PREFIX} id 2>/dev/null 1>/dev/null 
  if [ $? -ne 0 ] ; then

    echo "ERROR: The script \"$0\" needs root access"
    exit 254
  else
    ROOT_PREFIX="su - -c "
  fi
fi

ENV_FILE="/data/local/tmp/sysroot/dnsmasq/etc/dnsmasq_env.sh"

if ! ${ROOT_PREFIX} test -r  "${ENV_FILE}"  ; then
  echo "ERROR: The env file \"${ENV_FILE}\" needed by \"$0\" does not exist"
  exit 253
fi

PID_FILE="$(  ${ROOT_PREFIX} sh "${ENV_FILE}" PID_FILE )"

CUR_PID=""

# read the optional additional start options for dnsmasq from the environment file in the Magisk module
# 
DNSMASQ_START_OPTIONS_FILE="$( ${ROOT_PREFIX}  sh  "${ENV_FILE}"  DNSMASQ_START_OPTIONS_FILE  )"
[ -r "${DNSMASQ_START_OPTIONS_FILE}" ] && DNSMASQ_OPTIONS=$( grep -E -v "^$|^#" "${DNSMASQ_START_OPTIONS_FILE}" )

echo "${DNSMASQ_OPTIONS}" | grep -- "--pid-file=" >/dev/null || DNSMASQ_OPTIONS="${DNSMASQ_OPTIONS} --pid-file=${PID_FILE}"

# semaphor to disable the automatic start of the dnsmasq
#
DNSMASQ_STOP_FILE="$( ${ROOT_PREFIX} sh  "${ENV_FILE}" DNSMASQ_STOP_FILE )"

# dnsmasq binary
#
DNSMASQ_BINARY="$( ${ROOT_PREFIX} sh  "${ENV_FILE}" DNSMASQ_BINARY )"


function get_dnsmasq_status {
  DNSMASQ_IS_RUNNING=${__FALSE}

  if [ -r "${PID_FILE}" ] ; then
    CUR_PID="$( grep -v "^#" "${PID_FILE}" )"
    if [ "${CUR_PID}"x != ""x ] ; then
      ps -f -p ${CUR_PID} >/dev/null
      if [ $? -eq 0 ] ; then
        DNSMASQ_IS_RUNNING=${__TRUE}
      fi
    fi
  fi
}

# check, if dnsmasq is running
#
get_dnsmasq_status

if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then

#
# check for other processes using the port 53 
#
  CUR_OUTPUT="$( ${ROOT_PREFIX} netstat -tnlp 2>/dev/null | grep ":53 " 2>&1 )"
  if [ "${CUR_OUTPUT}"x != ""x ] ; then
    echo "ERROR: There is a unknown process listening on the port 53:"
    echo 
    echo "${CUR_OUTPUT}"
    echo ""
    echo "If that process is the correct dnsmasq, store the PID of the process in the file \"${PID_FILE}\" and restart this script "
    echo
    CUR_PID="$( echo "${CUR_OUTPUT}" |  awk '{ print $NF}' | cut -f1 -d "/" | uniq  )"

    echo " echo ${CUR_PID}>${PID_FILE}"
    echo 
    exit 100
  fi
fi

if [ $# -eq 0 ] ; then

  case $0 in
  
    *start_stop_dnsmasq )
      PARAMETER="--help"
      ;;

    *restart_dnsmasq )
      PARAMETER="restart"
      ;;
      
    *start_dnsmasq )
      PARAMETER="start"
      ;;

    *stop_dnsmasq )
      PARAMETER="stop"
      ;;

    *reload_dnsmasq )
      PARAMETER="reload"
      ;;

    *status_dnsmasq )
      PARAMETER="status"
      ;;

    * ) 
      echo "ERROR: Unknown script name \"$0\" "
      exit 5

  esac

  set -- ${PARAMETER}

fi


while [ $# -ne 0 ] ; do
  CUR_PARAMETER=$1
  shift

  case ${CUR_PARAMETER} in 
  
    -h | --help )
      echo "Usage: $0 [start|stop|status|restart|reload"
      exit 0
      ;;

    start )
      if [ ${DNSMASQ_IS_RUNNING} = ${__TRUE} ] ; then
        echo "The dnsmasq is already running: "
        ps -f -p ${CUR_PID}
        exit 0
      else
        echo "Starting the dnsmasq ..."
        ${ROOT_PREFIX} ${DNSMASQ_BINARY} ${DNSMASQ_OPTIONS}

        get_dnsmasq_status
        if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then
          echo "ERROR: Restarting the dnsmasq failed"
          exit 99
        fi
      fi
      ;;
  
    stop )
      if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then
        echo "The dnsmasq is not running "
        exit 0
      else
        echo "Stopping the dnsmasq ..."
        ${ROOT_PREFIX} kill ${CUR_PID}
      fi
      ;;
  
    restart )
      if [ ${DNSMASQ_IS_RUNNING} = ${__TRUE} ] ; then
        echo "Stopping the dnsmasq ..."
        ${ROOT_PREFIX} kill ${CUR_PID}
      fi
  
      echo "Starting the dnsmasq ..."
      ${ROOT_PREFIX} ${DNSMASQ_BINARY} ${DNSMASQ_OPTIONS}

      get_dnsmasq_status
      if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then
        echo "ERROR: Restarting the dnsmasq failed"
        exit 99
      fi
      ;;
      
    status )
      if [ ${DNSMASQ_IS_RUNNING} = ${__TRUE} ] ; then
        echo "The dnsmasq is running: "
        ps -f -p ${CUR_PID}
        THISRC=0
      else
        echo "The dnsmasq is not running "
        THISRC=1
      fi
      ;;
      
    reload )
      if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then
        echo "The dnsmasq is not running "
        THISRC=1
      else
        echo "Reloading the dnsmasq config ..."
        ${ROOT_PREFIX} kill -HUP ${CUR_PID}

        get_dnsmasq_status
        if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then
          echo "ERROR: Reloading the dnsmasq config failed"
          exit 99
        fi
      fi
      ;;
  
    * )
      echo "ERROR: Unknown parameter found: \"${CUR_PARAMETER}\" "
      exit 99
      ;;
  esac
done

