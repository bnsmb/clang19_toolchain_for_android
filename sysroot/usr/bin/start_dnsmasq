#!/system/bin/sh
#
# start/stop script for dnsmasq
#
# History
#   04.04.2026 /bs
#     initial release
#     

__TRUE=0
__FALSE=1

PID_FILE="/data/local/tmp/sysroot/dnsmasq/var/dnsmasq.pid"

CUR_PID=""

# read the optional additional start options for dnsmasq from the environment file in the Magisk module
# 
DNSMASQ_START_OPTIONS_FILE="$( su - -c sh /data/adb/modules/dnsmasq/dnsmasq_env.sh DNSMASQ_START_OPTIONS_FILE  )"
[ -r "${DNSMASQ_START_OPTIONS_FILE}" ] && DNSMASQ_OPTIONS=$( grep -E -v "^$|^#" "${DNSMASQ_START_OPTIONS_FILE}" )

# semaphor to disable the automatic start of the dnsmasq
#
DNSMASQ_STOP_FILE="$( su - -c sh /data/adb/modules/dnsmasq/dnsmasq_env.sh DNSMASQ_STOP_FILE )"

# dnsmasq binary
#
DNSMASQ_BINARY="/system/bin/dnsmasq"


function get_dnsmasq_status {
  DNSMASQ_IS_RUNNING=${__FALSE}
  
  if [ -r "${PID_FILE}" ] ; then
    CUR_PID="$( grep -v "^#" "${PID_FILE}" )"
    if [ "${CUR_PID}"x != ""x ] ; then
      ps -f -p ${CUR_PID} >/dev/null
      if [ $? -eq 0 ] ; then
        DNSMASQ_IS_RUNNING=${__TRUE}
      fi
    fi
  fi
}

# check, if dnsmasq is running
#
get_dnsmasq_status

if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then

#
# check for other processes using the port 53 
#
  CUR_OUTPUT="$( su - -c netstat -tnlp | grep ":53 " 2>&1 )"
  if [ "${CUR_OUTPUT}"x != ""x ] ; then
    echo "ERROR: There is a unknown process listening on the port 53:"
    echo 
    echo "${CUR_OUTPUT}"
    echo ""
    echo "If that process is the correct dnsmasq, store the PID of the process in the file \"${PID_FILE}\" and restart this script "
    echo
    CUR_PID="$( echo "${CUR_OUTPUT}" |  awk '{ print $NF}' | cut -f1 -d "/" | uniq  )"

    echo " echo ${CUR_PID}>${PID_FILE}"
    echo 
    exit 100
  fi
fi

if [ $# -eq 0 ] ; then

  case $0 in
  
    *start_stop_dnsmasq )
      PARAMETER="--help"
      ;;

    *enable_dnsmasq )
      PARAMETER="enable"
      ;;

   *disable_dnsmasq )
      PARAMETER="disable"
      ;;

    *restart_dnsmasq )
      PARAMETER="restart"
      ;;
      
    *start_dnsmasq )
      PARAMETER="start"
      ;;

    *stop_dnsmasq )
      PARAMETER="stop"
      ;;

    *reload_dnsmasq )
      PARAMETER="reload"
      ;;

    *status_dnsmasq )
      PARAMETER="status"
      ;;

    *is_enabled_dnsmasq )
      PARAMETER="is-enabled"
      ;;

    * ) 
      echo "ERROR: Unknown script name \"$0\" "
      exit 5

  esac

  set -- ${PARAMETER}

fi


while [ $# -ne 0 ] ; do
  CUR_PARAMETER=$1
  shift

  case ${CUR_PARAMETER} in 
  
    -h | --help )
      echo "Usage: $0 [start|stop|status|restart|reload|enable|disable|is-enabled"
      exit 0
      ;;

    enable )
      if su - -c test ! -r ${DNSMASQ_STOP_FILE} ; then
        echo "The automatic start of the dnsmasq is already enabled"
      else
        echo "Enabling the automatically start of the dnsmasq now ..."
        su - -c rm -f "${DNSMASQ_STOP_FILE}"
      fi
      ;;

    disable )
      if su - -c test  -r ${DNSMASQ_STOP_FILE} ; then
        echo "The automatic start of the dnsmasq is already disabled"
      else
        echo "Disabling the automatically start of the dnsmasq now ..."
        su - -c touch "${DNSMASQ_STOP_FILE}"    
      fi
      ;;

    is-enabled )
      if su - -c test  -r ${DNSMASQ_STOP_FILE} ; then
        echo "The automatic start of the dnsmasq is disabled"
	exit 1
      else
        echo "The automatic start of the dnsmasq is enabled"
	exit 0
      fi
      ;;

    start )
      if [ ${DNSMASQ_IS_RUNNING} = ${__TRUE} ] ; then
        echo "The dnsmasq is already running: "
        ps -f -p ${CUR_PID}
        exit 0
      else
        echo "Starting the dnsmasq ..."
        su - -c ${DNSMASQ_BINARY} ${DNSMASQ_OPTIONS}

        get_dnsmasq_status
        if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then
          echo "ERROR: Restarting the dnsmasq failed"
          exit 99
        fi
      fi
      ;;
  
    stop )
      if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then
        echo "The dnsmasq is not running "
        exit 0
      else
        echo "Stopping the dnsmasq ..."
        su - -c kill ${CUR_PID}
      fi
      ;;
  
    restart )
      if [ ${DNSMASQ_IS_RUNNING} = ${__TRUE} ] ; then
        echo "Stopping the dnsmasq ..."
        su - -c kill ${CUR_PID}
      fi
  
      echo "Starting the dnsmasq ..."
      su - -c ${DNSMASQ_BINARY} ${DNSMASQ_OPTIONS}

      get_dnsmasq_status
      if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then
        echo "ERROR: Restarting the dnsmasq failed"
        exit 99
      fi
      ;;
      
    status )
      if [ ${DNSMASQ_IS_RUNNING} = ${__TRUE} ] ; then
        echo "The dnsmasq is running: "
        ps -f -p ${CUR_PID}
        THISRC=0
      else
        echo "The dnsmasq is not running "
        THISRC=1
      fi
      ;;
      
    reload )
      if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then
        echo "The dnsmasq is not running "
        THISRC=1
      else
        echo "Reloading the dnsmasq config ..."
        su - -c kill -HUP ${CUR_PID}

        get_dnsmasq_status
        if [ ${DNSMASQ_IS_RUNNING} != ${__TRUE} ] ; then
          echo "ERROR: Reloading the dnsmasq config failed"
          exit 99
        fi
      fi
      ;;
  
    * )
      echo "ERROR: Unknown parameter found: \"${CUR_PARAMETER}\" "
      exit 99
      ;;
  esac
done

