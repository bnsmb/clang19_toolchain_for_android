# template file with ./configure command for using with the clang19 tool chain
#
#

APP="$( echo $PWD | awk -F/ '{ print $NF}' | cut -f1 -d"-" )"

# APP="openvpn"

# default target directory used by "make install"
#
TARGET_ROOT="${TARGET_ROOT:=/data/local/tmp/develop/sysroot}"

#TARGET_ROOT="/data/local/tmp/sysroot"
#
echo "Configuring \"${APP}\" for the target root \"${TARGET_ROOT}\" ..."

DEBUG_CFLAGS=""

# use these additional CFLAGs for binaries that should be executed using a debugger like gdb
# 
#DEBUG_CFLAGS="-g -O0"

# these configure options are required to compile the source code of a lot of  "old" unix programs with clang
# 
CFLAGS="${CFLAGS} -Wno-implicit-function-declaration -Wno-int-conversion ${DEBUG_CFLAGS}"


# add additional CFLAGS for the compiler here
#
CFLAGS="${CFLAGS} "

# C++ compiler options
# 
CXXFLAGS="${CFLAGS}"

# add additional LDFLAGS for the linker here
#
LDFLAGS="${LDFLAGS} "

CXXFLAGS="${CFLAGS}"

# add additional configure options here
#
CONFIGURE_OPTIONS="

  --prefix=${TARGET_ROOT}/usr 
  --exec-prefix=${TARGET_ROOT}/usr 

  --bindir=${TARGET_ROOT}/usr/bin 

  --sbindir=${TARGET_ROOT}/usr/bin
  --libexecdir=${TARGET_ROOT}/usr/libexec
  --sysconfdir=${TARGET_ROOT}/etc
  --sharedstatedir=${TARGET_ROOT}/usr/share/com
  --localstatedir=${TARGET_ROOT}/var
  --runstatedir=${TARGET_ROOT}/usr/run
  --libdir=${TARGET_ROOT}/usr/lib
  --includedir=${TARGET_ROOT}/usr/include
  --oldincludedir=${TARGET_ROOT}/usr/include
  --datarootdir=${TARGET_ROOT}/usr/share
  --datadir=${TARGET_ROOT}/usr/share
  --infodir=${TARGET_ROOT}/usr/share/info
  --localedir=${TARGET_ROOT}/usr/share/locale
  --mandir=${TARGET_ROOT}/usr/share/man
  --docdir=${TARGET_ROOT}/usr/share/doc/${APP}
  --htmldir=${TARGET_ROOT}/usr/share/doc/${APP}
  --dvidir=${TARGET_ROOT}/usr/share/doc/${APP}
  --pdfdir=${TARGET_ROOT}/usr/share/doc/${APP}
  --psdir=${TARGET_ROOT}/usr/share/doc/${APP}
"

#
# set PREFIX to "echo" or something similar before calling this script to run it in dry-run mode
#
${PREFIX}  ./configure  CFLAGS="${CFLAGS}" LDFLAGS="${LDFLAGS}" ${CONFIGURE_OPTIONS} $* 
THISRC=$?

echo
echo "Configuring \"${APP}\" for the target root \"${TARGET_ROOT}\" ended with RC=${THISRC}"


