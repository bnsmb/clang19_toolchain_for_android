"

CONFIGURE_OPTIONS="$( echo "${CONFIGURE_OPTIONS}" | grep -v "^#" )"


CFLAGS="$( echo "$CFLAGS" | tr "\n" " " )"
CXXFLAGS="$( echo "$CXXFLAGS" | tr "\n" " " )"
LDFLAGS="$( echo "$LDFLAGS" | tr "\n" " " )"
CPPFLAGS="$( echo "$CPPFLAGS" | tr "\n" " " )"

${PREFIX}  ./configure  --build=aarch64  --host ${TARGET} --target=${TARGET} --prefix=${TARGET_ROOT}/usr/ $* CFLAGS="${CFLAGS}" LDFLAGS="${LDFLAGS}" ${CONFIGURE_OPTIONS}  
