--with-openssl=/data/develop/android/sysroot/usr 
--enable-loadable-sqlite-extensions 
--enable-shared
--with-builtin-hashlib-hashes=md5,sha1,sha2,sha3,blake2,sha256,sha512 
--without-ensurepip  
--with-tzpath=/system/usr/share/zoneinfo 
--enable-static-libpython-for-interpreter

--with-build-python=/tools/python3.15/bin/python3.15 

